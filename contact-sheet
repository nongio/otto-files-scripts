#!/usr/bin/env python3
"""Contact Sheet: lay the selected pictures out on one page, with their names."""
import json, os, subprocess, sys

PICTURES = ["jpg", "jpeg", "png", "webp", "heic"]


def describe():
    return {"commands": [{
        "id": "sheet",
        "title": "Make Contact Sheet",
        "keywords": ["montage", "grid", "proof", "thumbnails"],
        "when": {"targets": "some", "extensions": PICTURES, "kinds": "files"},
        "arg": {"prompt": "Sheet name", "initial": "Contact Sheet.jpg", "preview": True},
        "progress": True,
    }]}


def destination(request):
    name = request.get("arg") or "Contact Sheet.jpg"
    return os.path.join(request["situation"]["path"], name)


def preview(request):
    rows = [{"from": os.path.basename(t)} for t in request["targets"]]
    name = os.path.basename(destination(request))
    return {"rows": rows, "note": f"{len(rows)} pictures on “{name}”"}


def run(request):
    out = destination(request)
    total = len(request["targets"])
    print(json.dumps({"done": 0, "total": total}), flush=True)
    subprocess.run([
        "montage", "-label", "%t", *request["targets"],
        "-auto-orient", "-thumbnail", "520x390", "-tile", "4x",
        "-geometry", "+16+16", "-background", "#f4f1ea",
        "-font", "DejaVu-Sans", "-pointsize", "18", out,
    ], check=True)
    print(json.dumps({"done": total, "total": total}), flush=True)
    return {"status": f"Made “{os.path.basename(out)}”",
            "changes": [{"kind": "created", "path": out}], "reload": True}


verb = sys.argv[1] if len(sys.argv) > 1 else ""
if verb == "describe":
    reply = describe()
elif verb in ("preview", "run"):
    reply = (preview if verb == "preview" else run)(json.load(sys.stdin))
else:
    sys.exit("usage: contact-sheet describe|preview|run")
json.dump(reply, sys.stdout)
